# ============================================================================
# 把本文件复制为 .env，然后只需改下面第一行的 DEEPSEEK_API_KEY
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# 在 DeepSeek 开放平台 https://platform.deepseek.com/api_keys 创建 API Key，
# 并先在「充值」页充值少量余额（DeepSeek API 不赠送免费额度）。
# ============================================================================

# ★ 唯一必填项：把你的 Key 粘在等号后面，不要加引号、不要留空格
DEEPSEEK_API_KEY=sk-在这里粘贴你的Key

DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash：快且便宜，本实验用它就够；想更强可改 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# 可选：本地中文向量/重排序模型（默认 bge，首次运行自动下载）
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RERANK_MODEL=BAAI/bge-reranker-base

# ---------------- 模型下载网络设置（按需选一条） ----------------
# a) 能直连 HuggingFace：
# HF_ENDPOINT=https://huggingface.co
# b) 默认走国内镜像 hf-mirror.com（不设即为此项）
# c) 直连不通但有本地代理（端口按自己的客户端改，Clash 默认 7897）：
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# d) 模型已下载完，想完全离线运行、不再联网校验：
# HF_HUB_OFFLINE=1

